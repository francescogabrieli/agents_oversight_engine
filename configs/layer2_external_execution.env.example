# Copy these names into a secret-injected environment; do not place real values here.
LAYER2_EXTERNAL_CAPABILITY_CONFIG_PATH=configs/layer2_external_capabilities.example.json

# SMTP connector
LAYER2_SMTP_HOST=smtp.provider.example
LAYER2_SMTP_PORT=587
LAYER2_SMTP_USERNAME=
LAYER2_SMTP_PASSWORD=
LAYER2_SMTP_SENDER=controlled-sender@example.org
LAYER2_SMTP_USE_TLS=true
LAYER2_SMTP_USE_SSL=false
LAYER2_SMTP_TIMEOUT_SECONDS=15

# Profile-bound SQLite connector
LAYER2_DATABASE_PROFILES_CONFIG_PATH=configs/layer2_database_profiles.example.json
LAYER2_DATABASE_DEDICATED_TEST_DSN=artifacts/runtime/external/dedicated-e2e.sqlite3
LAYER2_DATABASE_REPORTING_DSN=artifacts/runtime/external/reporting.sqlite3

# Durable server-side idempotency ledger
LAYER2_EXTERNAL_SERVER_LEDGER_PATH=artifacts/runtime/external/server_idempotency.sqlite3
