# Resolve these paths to absolute paths before copying them into the local .env.
# The database MCP child runs from src/, so relative paths are intentionally avoided.
LAYER2_EXTERNAL_CAPABILITY_CONFIG_PATH=C:\absolute\path\to\repo\configs\layer2_external_capabilities.evaluation.json
LAYER2_DATABASE_PROFILES_CONFIG_PATH=C:\absolute\path\to\repo\configs\layer2_database_profiles.evaluation.json
LAYER2_DATABASE_REPORTING_DSN=C:\absolute\path\to\repo\artifacts\evaluation\fixtures\evaluation_incidents_v1.sqlite3
