{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local/layer2/governance_decision_output.schema.json",
  "title": "GovernanceDecisionOutput",
  "type": "object",
  "required": [
    "schema_version",
    "directive",
    "policy_decision",
    "reason_codes",
    "pillar_results",
    "selected_reason",
    "rejected_alternatives",
    "safety_invariants_checked",
    "requires_human_review",
    "policy_bundle_version",
    "policy_config_version"
  ],
  "properties": {
    "schema_version": { "const": "governance_decision_output.v1" },
    "directive": {
      "enum": [
        "continue",
        "continue_read_only",
        "revise_action",
        "request_more_evidence",
        "replan",
        "ask_user_clarification",
        "wait_human_review",
        "stop"
      ]
    },
    "policy_decision": {
      "enum": ["allow", "allow_read_only", "ask_clarification", "require_human_review", "deny"]
    },
    "reason_codes": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1
    },
    "pillar_results": {
      "type": "object",
      "required": ["static_policy", "evidence", "risk", "trajectory", "behavioral", "judge"],
      "properties": {
        "static_policy": {
          "type": "object",
          "required": ["hard_deny", "constraints", "violations", "reason_codes", "summary"],
          "properties": {
            "hard_deny": { "type": "boolean" },
            "constraints": { "type": "array", "items": { "type": "string" } },
            "violations": { "type": "array", "items": { "type": "string" } },
            "reason_codes": { "type": "array", "items": { "type": "string" } },
            "summary": { "type": "string" }
          },
          "additionalProperties": true
        },
        "evidence": { "type": "object" },
        "risk": { "type": "object" },
        "trajectory": { "type": "object" },
        "behavioral": { "type": "object" },
        "judge": { "type": "object" }
      },
      "additionalProperties": false
    },
    "selected_reason": { "type": "string", "minLength": 1 },
    "rejected_alternatives": { "type": "object" },
    "safety_invariants_checked": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "requires_human_review": { "type": "boolean" },
    "policy_bundle_version": { "type": "string", "minLength": 1 },
    "policy_config_version": { "type": "string", "minLength": 1 }
  },
  "additionalProperties": true
}
